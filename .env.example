LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini API key for the Gemini Live API realtime model.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional compatible Gemini Live overrides; blank values use these defaults.
# Both use the Google AI Studio / Gemini Developer API key above.
IRA_GEMINI_PRIMARY_MODEL=gemini-3.8-live
IRA_GEMINI_FALLBACK_MODEL=gemini-2.5-flash-native-audio-latest
# Set IRA_GEMINI_FALLBACK_MODEL=gemini-3.8-live-extended-thinking for deep reasoning fallback
# IRA_THINKING_LEVEL=low

# Task/target admission for desktop, browser and saved-skill actions.
# Uses GOOGLE_API_KEY above; blank uses this default. Failed checks stop input.
IRA_REQUEST_SCOPE_MODEL=gemini-3.5-flash-lite

# SQLite database shared by memory, voice tasks and the dashboard bridge.
# IRA_MEMORY_DB=C:\\Users\\YourName\\Documents\\IRA\\ira_memory.db

# Canonical profile, conversation journal, facts and context checkpoints.
# Default: memories/personal.sqlite3. Bridge and agent must share this path.
# IRA_PERSONAL_MEMORY_DB=C:\\Users\\YourName\\Documents\\IRA\\personal.sqlite3
# IRA_MEMORIES_DIR=C:\\Users\\YourName\\Documents\\IRA\\memories
# Summarizer/model and context budgets are configured in Settings → Memory and Context.

# Real Gemini evals cost inference and are opt-in. Normal pytest stays offline.
# IRA_RUN_LIVE_EVALS=1
# IRA_RUN_SCOPE_LIVE=1

# Local browser used by the browsing and Spotify tools.
# Use "chrome" or "brave". The profile must already be signed in to Spotify.
IRA_BROWSER=chrome
IRA_BROWSER_PROFILE_NAME=Default
# Optional: full path to a profile directory, which overrides the two settings above.
# IRA_BROWSER_PROFILE=C:\\Users\\YourName\\AppData\\Local\\Google\\Chrome\\User Data\\Default

# Directory for reusable Markdown workflows.
# IRA_WORKFLOWS_DIR=C:\\Users\\YourName\\Documents\\IRA\\workflows
